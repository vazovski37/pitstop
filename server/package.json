{
  "name": "@pitstop/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "dev": "tsx watch --env-file-if-exists=../.env src/index.ts",
    "migrate": "tsx --env-file-if-exists=../.env src/migrate-cli.ts",
    "start": "node dist/index.js"
  },
  "dependencies": {
    "@fastify/websocket": "^11.0.0",
    "@pitstop/protocol": "0.1.0",
    "fastify": "^5.2.0",
    "pg": "^8.13.0"
  },
  "devDependencies": {
    "@types/pg": "^8.11.0",
    "@types/ws": "^8.5.0",
    "ws": "^8.22.0"
  }
}
