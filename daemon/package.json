{
  "name": "@pitstop/daemon",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "pitstop": "dist/index.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "dev": "tsx --env-file-if-exists=../.env src/index.ts",
    "fake-server": "tsx src/fake-server.ts"
  },
  "dependencies": {
    "@pitstop/protocol": "0.1.0",
    "typescript": "^5.7.0",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/ws": "^8.5.0"
  }
}
