# Copy to .env for local development. Never commit .env.
DATABASE_URL=postgresql://pitstop:pitstop@localhost:5432/pitstop
PORT=8080
# Who resolves write skew (Phase 4): agent (the coding agent that committed is told what changed and
# commits again), groq (the server asks Groq Cloud for a patch and type-checks it), or off.
PITSTOP_REPAIR=agent
# For PITSTOP_REPAIR=groq: a Groq Cloud API key (free at console.groq.com) and a production model id.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
# Phase 3: the git mirror pushes every accepted entry to a GitHub branch. A fine-grained token with
# "Contents: write" on the mirrored repositories. Empty = no mirroring (PUT /repos/:owner/:name/mirror answers 501).
MIRROR_GITHUB_TOKEN=
# Phase 5: accounts. A GitHub OAuth App (callback <server>/auth/github/callback) and a random cookie secret.
# Empty = no sign-in; the shared PITSTOP_TOKEN (or an open server) keeps working.
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=
SESSION_SECRET=
# Where the browser goes after signing in (the web app), and this server's public https URL for the OAuth redirect.
PITSTOP_WEB_URL=
PITSTOP_PUBLIC_URL=
# Host port of the local Postgres from `npm run db:up`. Change it when 5432 is taken, and DATABASE_URL with it.
PITSTOP_DB_PORT=5432
# Set PITSTOP_STORE=memory to run the server without Postgres (nothing is persisted).
# Shared token the daemon sends and the server checks (Phase 2). Empty = the server is open.
# On Azure it comes from the GitHub secret of the same name (SETUP.md, "Server token").
PITSTOP_TOKEN=
# What the validator does with write skew until AI repair exists: warn (default, lands it and says so), enforce (refuses it), off.
PITSTOP_VALIDATE=warn
# Run the type-check gate (tsc on the merged tree) on every commit: always, or off (default; the repair path still uses it).
PITSTOP_CHECK=off
