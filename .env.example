# Copy to .env for local development. Never commit .env.
DATABASE_URL=postgresql://pitstop:pitstop@localhost:5432/pitstop
PORT=8080
# Needed from Phase 4 (AI repair). Leave empty until then.
ANTHROPIC_API_KEY=
# Host port of the local Postgres from `npm run db:up`. Change it when 5432 is taken, and DATABASE_URL with it.
PITSTOP_DB_PORT=5432
# Set PITSTOP_STORE=memory to run the server without Postgres (nothing is persisted).
# Shared token the daemon sends and the server checks (Phase 2). Empty = the server is open.
# On Azure it comes from the GitHub secret of the same name (SETUP.md, "Server token").
PITSTOP_TOKEN=
# What the validator does with write skew until AI repair exists: warn (default, lands it and says so), enforce (refuses it), off.
PITSTOP_VALIDATE=warn
# Run the type-check gate (tsc on the merged tree) on every commit: always, or off (default; the repair path still uses it).
PITSTOP_CHECK=off
