# Copy to .env for local development. Never commit .env.
DATABASE_URL=postgresql://pitstop:pitstop@localhost:5432/pitstop
PORT=8080
# Needed from Phase 4 (AI repair). Leave empty until then.
ANTHROPIC_API_KEY=
# Host port of the local Postgres from `npm run db:up`. Change it when 5432 is taken, and DATABASE_URL with it.
PITSTOP_DB_PORT=5432
# Set PITSTOP_STORE=memory to run the server without Postgres (nothing is persisted).
